# Copy to .env and fill in values
# cp .env.example .env

DATABASE_URL=postgres://postgres:changeme@host:5432/tpwtp?sslmode=disable
# POLL_INTERVAL=5m
# API_CONCURRENCY=15
# API_TIMEOUT=10s
# LOG_LEVEL=info

# Weather source (opt-in): set WEATHER_API_KEY to an OpenWeatherMap One Call 3.0 key
# ("One Call by Call" subscription) to enable it. Leave unset to disable weather polling.
# One call per ~2km park-cluster returns current + hourly forecast; tune the interval to
# stay under the 1,000 calls/day free tier for your cluster count (logged as clusters_polled).
# WEATHER_API_KEY=
# WEATHER_POLL_INTERVAL=60m