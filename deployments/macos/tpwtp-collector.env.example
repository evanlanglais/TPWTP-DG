# TPWTP Collector Environment Configuration
# Copy this to /etc/tpwtp-collector/tpwtp-collector.env and fill in values

# Database connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/tpwtp?sslmode=disable

# Poll interval (how often to fetch wait times)
POLL_INTERVAL=5m

# API concurrency (max concurrent requests to themeparks.wiki)
API_CONCURRENCY=15

# API timeout (per-request timeout)
API_TIMEOUT=10s

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
